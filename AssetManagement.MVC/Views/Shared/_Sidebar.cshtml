@{
    var role = Context.Session.GetString("Role");
}

<div class="bg-dark text-white p-3 vh-100">

    <h4 class="text-center mb-4">
        Menu
    </h4>

    <ul class="nav flex-column">

        <!-- Dashboard -->

        <li class="nav-item mb-2">
            <a class="nav-link text-white"
               asp-controller="Dashboard"
               asp-action="Index">
                Dashboard
            </a>
        </li>

        <!-- Assets -->

        <li class="nav-item mb-2">
            <a class="nav-link text-white"
               asp-controller="Asset"
               asp-action="Index">
                Assets
            </a>
        </li>

        @if (role == "Admin")
        {
            <!-- Employees -->

            <li class="nav-item mb-2">
                <a class="nav-link text-white"
                   asp-controller="Employee"
                   asp-action="Index">
                    Employees
                </a>
            </li>

            <!-- Categories -->

            <li class="nav-item mb-2">
                <a class="nav-link text-white"
                   asp-controller="Category"
                   asp-action="Index">
                    Categories
                </a>
            </li>

            <!-- Asset Assignment -->

            <li class="nav-item mb-2">
                <a class="nav-link text-white"
                   asp-controller="AssetAssignment"
                   asp-action="Index">
                    Asset Assignment
                </a>
            </li>
        }

        <!-- Reports -->

        <li class="nav-item mb-2">
            <a class="nav-link text-white"
               asp-controller="Report"
               asp-action="Index">
                Reports
            </a>
        </li>

        <!-- Logout -->

        <li class="nav-item mt-4">
            <a class="nav-link text-danger"
               asp-controller="Account"
               asp-action="Login">
                Logout
            </a>
        </li>

    </ul>

</div>