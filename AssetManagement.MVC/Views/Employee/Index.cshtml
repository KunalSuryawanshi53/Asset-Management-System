@model IEnumerable<AssetManagement.MVC.Models.EmployeeViewModel>

@{
    ViewData["Title"] = "Employees";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">

        @TempData["Success"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">

    <h2>Employee Management</h2>

    <a asp-action="Add"
       asp-controller="Employee"
       class="btn btn-primary">
        Add Employee
    </a>

</div>

<!-- Search -->

<form method="get"
      asp-action="Index"
      class="row mb-4">

    <div class="col-md-5">

        <input type="text"
               name="keyword"
               class="form-control"
               placeholder="Search by Name, Email or Employee Code..."
               value="@ViewBag.Keyword" />

    </div>

    <div class="col-md-3">

        <button type="submit"
                class="btn btn-primary">
            Search
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Reset
        </a>

    </div>

</form>

<table class="table table-bordered table-hover">

    <thead class="table-dark">

        <tr>
            <th>Employee Code</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Department</th>
            <th>Designation</th>
            <th>Hire Date</th>
            <th>Action</th>
        </tr>

    </thead>

    <tbody>

        @if (Model != null && Model.Any())
        {
            foreach (var employee in Model)
            {
                <tr>

                    <td>@employee.EmployeeCode</td>
                    <td>@employee.FirstName</td>
                    <td>@employee.LastName</td>
                    <td>@employee.Email</td>
                    <td>@employee.Phone</td>
                    <td>@employee.DepartmentName</td>
                    <td>@employee.Designation</td>
                    <td>@employee.HireDate.ToString("dd-MMM-yyyy")</td>

                    <td>

                        <a asp-action="Edit"
                           asp-route-id="@employee.EmployeeId"
                           class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@employee.EmployeeId"
                           class="btn btn-danger btn-sm">
                            Delete
                        </a>

                    </td>

                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="9" class="text-center text-danger fw-bold py-4">
                    No employee found matching your search.
                </td>
            </tr>
        }

    </tbody>

</table>